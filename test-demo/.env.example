# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Supabase (backend token verification + sync) ---
SUPABASE_URL=https://qmjwnfmcdepibytbirbl.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_KEY=
# Only these accounts may use the API (comma-separated). Strongly recommended.
ALLOWED_EMAILS=you@example.com

# --- Flask API ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Telegram scraper (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate once with: python telegram_login.py
TELEGRAM_SESSION_STRING=

# --- AI lead qualification (lead_quality.py) ---
ANTHROPIC_API_KEY=
AI_QUALIFY_LIMIT=40
MIN_AI_SCORE_FOR_AUTO_EMAIL=7

# --- Email outreach ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
AUTO_SEND_EMAIL=false
MAX_PENDING_EMAILS_PER_RUN=5

# --- Slack hot-lead alerts (slack_notifier.py) ---
# Slack app -> Incoming Webhooks -> Add New Webhook -> pick channel. Keep secret.
SLACK_WEBHOOK_URL=
MIN_AI_SCORE_FOR_SLACK=7
SLACK_MAX_PER_RUN=20

# --- Feedly lead source (feedly_scraper.py) ---
# Option A - Feedly API (Enterprise token from feedly.com/i/team/api)
FEEDLY_ACCESS_TOKEN=
FEEDLY_STREAM_IDS=
# Option B - free: export OPML from Feedly to feedly_feeds.opml, and/or list RSS URLs here
FEEDLY_FEEDS=https://www.reddit.com/r/forhire/new/.rss,https://www.reddit.com/r/freelance_forhire/new/.rss
FEEDLY_MAX_AGE_DAYS=7
# Optional: override the intent keywords (comma-separated)
FEEDLY_KEYWORDS=
