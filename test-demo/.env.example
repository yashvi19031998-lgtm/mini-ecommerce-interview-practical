# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Supabase (backend token verification + sync) ---
SUPABASE_URL=https://qmjwnfmcdepibytbirbl.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_KEY=
# Only these accounts may use the API (comma-separated). Strongly recommended.
ALLOWED_EMAILS=you@example.com

# --- Flask API ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Telegram scraper (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate once with: python telegram_login.py
TELEGRAM_SESSION_STRING=

# --- AI lead qualification (lead_quality.py) ---
ANTHROPIC_API_KEY=
AI_QUALIFY_LIMIT=40
MIN_AI_SCORE_FOR_AUTO_EMAIL=7

# --- Email outreach ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
# Set to true only when you are ready for automatic outreach (default: off)
AUTO_SEND_EMAIL=false
MAX_PENDING_EMAILS_PER_RUN=5

# --- Slack hot-lead alerts (slack_notifier.py) ---
# Slack app -> Incoming Webhooks -> Add New Webhook -> pick channel. Keep secret.
SLACK_WEBHOOK_URL=
MIN_AI_SCORE_FOR_SLACK=7
SLACK_MAX_PER_RUN=20

# --- Feedly lead source (feedly_scraper.py) ---
# Option A - Feedly API (Enterprise token from feedly.com/i/team/api)
FEEDLY_ACCESS_TOKEN=
FEEDLY_STREAM_IDS=
# Option B - free: export OPML from Feedly to feedly_feeds.opml, and/or list RSS URLs here
FEEDLY_FEEDS=https://www.reddit.com/r/forhire/new/.rss,https://www.reddit.com/r/freelance_forhire/new/.rss
FEEDLY_MAX_AGE_DAYS=7
# Optional: override the intent keywords (comma-separated)
FEEDLY_KEYWORDS=senior developer,tech lead,8+ years,9+ years,lead engineer,full stack architect,staff engineer,next.js,react,python,flutter,budget

# --- Lead accuracy ---
# Describe the clients you want; the AI scores leads against this. Leave empty for the default
# (senior 8-9+ years agency profile, budget ~USD 1000+ / INR 80,000+).
IDEAL_CLIENT_PROFILE=
# Leads older than this (post date, or first-seen date if unknown) are capped at score 4:
# no Slack alert and no auto-email.
STALE_AFTER_DAYS=14
# How much of each post the AI reads
MAX_DESCRIPTION_CHARS=2000

# --- Extra lead sources ---
# Built-in Reddit buyer search + founder subreddits + startup funding news (intent_feeds.py)
INTENT_FEEDS_ENABLED=true
# Freelancer.com live projects (freelancer_api_scraper.py). Contact these clients by bidding on Freelancer.com.
FREELANCER_QUERIES=senior developer,tech lead,full stack architect,nextjs react,python ai,flutter senior
FREELANCER_MIN_BUDGET_USD=500
FREELANCER_MIN_HOURLY_USD=25
FREELANCER_MAX_BIDS=60
# Saved company/contact pages are re-downloaded after this many days (html_cache_manager.py)
HTML_CACHE_MAX_AGE_DAYS=30

# --- Apollo.io B2B Intelligence & Contact Enrichment (apollo_enricher.py) ---
# Sign up at https://apollo.io -> Settings -> Integrations -> API Keys
APOLLO_API_KEY=
# Max companies enriched per runner execution (conserves credits)
APOLLO_ENRICH_LIMIT_PER_RUN=15
# Target job titles to find at company domains (comma-separated)
APOLLO_TARGET_TITLES=founder,co-founder,ceo,owner,managing director,cto,vp of engineering,head of engineering,director of technology
# Optional: search terms to harvest brand-new B2B leads directly from Apollo
APOLLO_SEARCH_KEYWORDS="Senior Developer" OR "Tech Lead" OR "Lead Engineer" OR "Software Architect" OR "8+ years" OR "Next.js" OR "Full Stack"
APOLLO_SEARCH_LOCATIONS=United States,United Kingdom,Canada,Australia,India

